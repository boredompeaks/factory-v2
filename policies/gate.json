{
  "version": 1,
  "engines": [
    "sqlite",
    "postgres"
  ],
  "test_infra_paths": [
    "**/conftest.py",
    "**/pytest.ini",
    "**/tox.ini",
    "**/.coveragerc",
    "tests/**",
    "backend/**/tests/**",
    "scripts/test*",
    "Makefile"
  ],
  "lint": "ruff",
  "lint_command": "ruff check",
  "gate_paths": [
    "tools/**",
    "policies/**",
    ".github/workflows/**"
  ],
  "gate_checks": [
    "SCOPE",
    "SUITE",
    "TEST_SET",
    "TEST_INFRA",
    "BASE_FAIL_HEAD_PASS",
    "MUTATION",
    "CHANGELOG",
    "SECRETS",
    "CONVENTION",
    "SMELL",
    "GATE_CONTROLS",
    "POLICY_DIGEST",
    "ARCH",
    "ORACLE_PROVENANCE",
    "GUARD_DELTA",
    "AUTHZ_MATRIX",
    "SEMGREP",
    "THREAD_RACE",
    "SCHEMA_FUZZ",
    "BOOTTEST",
    "ZIZMOR",
    "DAST_BASELINE",
    "AGT_PARITY",
    "AGT_AUDIT",
    "RADON",
    "BANDIT"
  ],
  "gate_sets_by_kind": {
    "DOC": [
      "SCOPE",
      "CHANGELOG",
      "SECRETS",
      "CONVENTION"
    ],
    "FIX": [
      "SCOPE",
      "SUITE",
      "TEST_SET",
      "TEST_INFRA",
      "BASE_FAIL_HEAD_PASS",
      "MUTATION",
      "SECRETS",
      "CONVENTION",
      "SMELL",
      "SEMGREP",
      "ARCH",
      "RADON",
      "BANDIT",
      "ZIZMOR"
    ],
    "FEATURE": [
      "SCOPE",
      "SUITE",
      "TEST_SET",
      "TEST_INFRA",
      "BASE_FAIL_HEAD_PASS",
      "MUTATION",
      "SECRETS",
      "CONVENTION",
      "SMELL",
      "SEMGREP",
      "ARCH",
      "RADON",
      "BANDIT",
      "ZIZMOR"
    ],
    "SECURITY": [
      "SCOPE",
      "SUITE",
      "TEST_SET",
      "TEST_INFRA",
      "BASE_FAIL_HEAD_PASS",
      "MUTATION",
      "SECRETS",
      "CONVENTION",
      "SMELL",
      "SEMGREP",
      "ARCH",
      "RADON",
      "BANDIT",
      "AUTHZ_MATRIX",
      "GUARD_DELTA",
      "ORACLE_PROVENANCE",
      "ZIZMOR",
      "DAST_BASELINE"
    ],
    "release": [
      "SCOPE",
      "SUITE",
      "TEST_SET",
      "TEST_INFRA",
      "BASE_FAIL_HEAD_PASS",
      "MUTATION",
      "SECRETS",
      "CONVENTION",
      "SMELL",
      "SEMGREP",
      "ARCH",
      "RADON",
      "BANDIT",
      "AUTHZ_MATRIX",
      "GUARD_DELTA",
      "ORACLE_PROVENANCE",
      "DAST_BASELINE",
      "THREAD_RACE",
      "SCHEMA_FUZZ",
      "BOOTTEST",
      "ZIZMOR",
      "POLICY_DIGEST"
    ]
  },
  "proof_rule": "Proofs are computed by the harness; release requires Proof-Root.",
  "policy_digest_scope": [
    "policies/**"
  ],
  "gate_control_cache_key": [
    "gate_sha",
    "control_set_sha",
    "policy_digest"
  ],
  "gate_control_required": true
}
