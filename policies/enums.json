  "non_enum_labels": {
    "SHIP": "Retired label. The draft used SHIP as a verdict synonym; all SOPs now use PASS.",
    "compliance status": "IMPLEMENTED/PARTIAL/MISSING/DEVIATES/NOT-APPLICABLE/DEFERRED are compliance report statuses, not one of the registered enum families.",
    "NON_FALSIFIABLE": "A catalog classification for a base-green exploit spec, not a result token.",
    "FAILED_PUSH": "A recorded push subcase; the verdict remains the registered verdict token."
  },
  "conflicts": [
    "result: proposed DONE is serialized as result_type RESULT; NOT_RUN is a check/catalog outcome, not a result_type.",
    "check: NOT_APPLICABLE is catalog-only; it is never a check outcome. A non-applicable check records NOT_RUN and cites the condition in evidence_ref.",
    "release: proposed HOLD is an orchestrator decision, not a release-result outcome; REFUSED is a result_type.",
    "severity: proposed P0/P4 dropped because files/policies/schemas/finding.json and files/policies/severity.json define P1/P2/P3 only."
  ]
