{
  "version": 2,
  "scope": "live",
  "description": "Single canonical token registry for the role SOPs. SOPs use only the tokens in this file. The schemas under files/policies/schemas/ are authoritative and are not modified by this registry; schema_value records the wire value where a canonical SOP token serializes differently.",
  "families": {
    "decision": {
      "tokens": [
        "DISPATCH",
        "HOLD",
        "HALT",
        "RECORD"
      ],
      "schema_source": "files/policies/schemas/orchestrator-decision.json#/properties/action",
      "status": "matches-schema"
    },
    "verdict": {
      "tokens": [
        "PASS",
        "BLOCK",
        "INCONCLUSIVE",
        "REFUSED"
      ],
      "schema_source": "files/policies/schemas/auditor-verdict.json#/properties/verdict and #/properties/result_type",
      "schema_value": {
        "REFUSED": "result_type=REFUSED (refusal_code carries the cause)"
      },
      "status": "compatible-schema: REFUSED is a result_type token in the verdict schema"
    },
    "result": {
      "tokens": [
        "DONE",
        "BLOCKED",
        "REFUSED",
        "NOT_RUN"
      ],
      "schema_source": "files/policies/schemas/builder-result.json#/properties/result_type; files/policies/schemas/hacker-result.json#/properties/result_type; files/policies/schemas/release-result.json#/properties/result_type; files/policies/schemas/crouton-result.json#/properties/status",
      "schema_value": {
        "DONE": "RESULT (builder, hacker, release); DONE (crouton status)",
        "BLOCKED": "BLOCKED (builder and crouton); hacker and release use REFUSED",
        "REFUSED": "REFUSED",
        "NOT_RUN": "no result_type; use the check or catalog outcome field"
      },
      "status": "conflict-recorded: DONE serializes as result_type RESULT for builder, hacker, and release, and as status DONE for crouton; NOT_RUN is not a result_type"
    },
    "check": {
      "tokens": [
        "PASS",
        "FAIL",
        "NOT_RUN"
      ],
      "schema_source": "files/policies/schemas/auditor-verdict.json#/$defs/check/properties/outcome",
      "catalog_only": {
        "NOT_APPLICABLE": "files/policies/schemas/auditor-verdict.json#/$defs/catalog_entry/properties/outcome"
      },
      "status": "schema-matched: check.outcome is PASS/FAIL/NOT_RUN; NOT_APPLICABLE is catalog-only and is never a check result"
    },
    "catalog": {
      "tokens": [
        "REFUTED",
        "REPRODUCED",
        "NOT_RUN",
        "NOT_APPLICABLE"
      ],
      "schema_source": "files/policies/schemas/hacker-result.json#/$defs/catalog_item/properties/outcome; files/policies/schemas/auditor-verdict.json#/$defs/catalog_entry/properties/outcome",
      "schema_value": {
        "NOT_RUN": "catalog_item.outcome=NOT_RUN",
        "NOT_APPLICABLE": "auditor catalog_entry only; the hacker never claims it, and an applicable item claimed NOT_APPLICABLE becomes NOT_RUN"
      },
      "status": "schema-matched: REFUTED/REPRODUCED are hacker outcomes; NOT_APPLICABLE is auditor-side only. REPRODUCED is a shared spelling with the drain state, not a shared field."
    },
    "repro_expected": {
      "tokens": [
        "REPRODUCED",
        "NOT_REPRODUCED"
      ],
      "schema_source": "files/policies/schemas/repro-spec.json#/properties/expected/properties/head and #/properties/expected/properties/base",
      "status": "matches-schema: the differential expected pair; fix is base REPRODUCED / head NOT_REPRODUCED, regression is the inverse"
    },
    "release": {
      "tokens": [
        "MERGED",
        "REFUSED",
        "HOLD"
      ],
      "schema_source": "files/policies/schemas/release-result.json#/properties/outcome and #/properties/result_type",
      "schema_value": {
        "MERGED": "outcome=MERGED",
        "REFUSED": "result_type=REFUSED (refusal_code carries the cause)",
        "HOLD": "orchestrator decision=HOLD; not a release-result outcome"
      },
      "status": "conflict-recorded: HOLD is an orchestrator disposition, not a release-result outcome"
    },
    "drain": {
      "tokens": [
        "OPEN",
        "REPRODUCED",
        "UNREPRODUCIBLE",
        "CLUSTERED",
        "REPAIRED",
        "VERIFIED",
        "CLOSED"
      ],
      "schema_source": "files/policies/schemas/drain-record.json#/properties/state",
      "status": "matches-schema"
    },
    "severity": {
      "tokens": [
        "P1",
        "P2",
        "P3"
      ],
      "schema_source": "files/policies/schemas/finding.json#/properties/severity; files/policies/severity.json#/severity_scale",
      "status": "schema-wins: proposed P0 and P4 are absent from both the schema and severity.json and are not used"
    },
    "bug_report": {
      "tokens": [
        "COMPLETE",
        "PARTIAL",
        "BLOCKED"
      ],
      "schema_source": "files/policies/schemas/bug-report.json#/properties/verdict; files/policies/schemas/compliance-result.json#/properties/verdict",
      "status": "matches-schema: the same coverage verdict is used by the bug report and the compliance result"
    },
    "phase": {
