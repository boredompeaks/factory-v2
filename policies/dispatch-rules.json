{
  "version": 1,
  "evaluation": {
    "mode": "all_matching_rules",
    "order": "rule_id",
    "before_target": "builder",
    "max_prebuild_dispatches": 2,
    "halt_on_compliance_fail": true
  },
  "k1_slots": {
    "policy_ref": "files/policies/concurrency.json",
    "keys": [
      "k1_total",
      "k1_per_lane"
    ],
    "refusal_code": "K1_SLOT_BUSY",
    "rule": "factory k1 up atomically acquires one host slot and one slot on the lane named by the task context (task.lane/task.branch); a lane-less capability is refused with K1_SLOT_LANE_REQUIRED. A taken host or lane slot is refused with K1_SLOT_BUSY naming holder run_id/lane/expiry; there is no queue. factory k1 down and TTL expiry release slots. Capacity values live only in files/policies/concurrency.json."
  },
  "phase_policy_ref": "files/policies/phases.json",
  "factory_edit_ban": {
    "statement": "The factory tree is not product scope; no role edits it.",
    "paths": [
      "files/policies/**",
      "policies/**",
      "files/tools/**",
      "tools/**",
      ".opencode/**",
      ".github/**"
    ],
    "enforced_by": "persona edit/write deny rules (last match wins) plus the A15 fixture mode/digest check",
    "history": "A54: the empty-task_kind catch-all policy rule was deleted because it routed factory paths to builder, contradicting this ban. Dispatch never grants factory edits."
  },
  "rules": [
    {
      "rule_id": "DR-DRAIN-01",
      "match": {
        "task_kind": [
          "DRAIN"
        ],
        "scope_globs": [
          "backend/**/views/**",
          "backend/**/api/**",
          "backend/**/serializers/**",
          "backend/**/orders/**",
          "backend/**/cart/**",
          "backend/**/shipping/**",
          "backend/**/migrations/**",
          "backend/**/common/**",
          "backend/common/**",
          "backend/**/accounts/**",
          "backend/**/account/**",
          "backend/**/roles/**",
          "backend/**/permissions/**",
          "backend/**/settings/**",
          "backend/**/settings.py",
          "backend/settings.py",
          "backend/settings/**",
          "backend/urls.py",
          "backend/**/urls.py",
          "backend/accounts/**",
          "backend/roles/**",
          "backend/accounts/views.py",
          "backend/accounts/models.py",
          "backend/common/roles.py",
          "backend/common/fields.py",
          "backend/common/testing.py",
          "backend/config/settings.py",
          "backend/orders/models.py",
          "frontend/**/checkout/**",
          "frontend/**/auth/**",
          "evidence/**",
          "**/*.sql"
        ],
        "keywords": [
          "role",
          "permission",
          "account",
          "checkout",
          "settings",
          "policy",
          "gate",
          "workflow",
          "migration",
          "common",
          "github"
        ]
      },
      "require_records": [
        {
          "stage": "R1",
          "schema": "drain-record/1",
          "min_count": 1
        },
        {
          "stage": "R2",
          "schema": "drain-record/1",
          "min_count": 1
        },
        {
          "stage": "R3",
          "schema": "drain-record/1",
          "min_count": 1
        }
      ],
      "require_before": "builder",
      "dispatch_first": [
        "compliance"
      ],
      "on_missing": {
        "action": "HALT",
        "reason_code": "DRAIN_STAGE_MISSING"
      },
      "on_compliance_result": {
        "PASS": {
          "action": "CONTINUE"
        },
        "FAIL": {
          "action": "HALT",
          "reason_code": "CTRL_FAILED"
        }
      }
    },
    {
      "rule_id": "DR-SPEC-01",
      "match": {
        "task_kind": [
          "FEATURE",
          "FIX",
          "SECURITY",
          "INFRA",
          "DOC"
        ],
        "scope_globs": [
          "backend/docs/spec/**",
          "**/docs/spec/**",
          "**/requirements*.txt",
          "**/requirements*.in",
          "**/pyproject.toml",
          "**/package-lock.json",
          "**/poetry.lock",
          "**/Pipfile.lock",
          "backend/docs/compliance/**"
        ],
        "keywords": [
          "spec",
          "requirement",
          "compliance"
        ]
      },
      "require_before": "builder",
      "dispatch_first": [
        "compliance"
      ],
      "on_compliance_result": {
        "PASS": {
          "action": "CONTINUE"
        },
        "FAIL": {
          "action": "HALT",
          "reason_code": "CTRL_FAILED"
        }
      }
    },
    {
      "rule_id": "DR-SECURITY-01",
      "match": {
        "task_kind": [
          "SECURITY"
        ],
        "scope_globs": [
          "backend/**/auth/**",
          "backend/**/mfa/**",
          "backend/**/accounts/**",
          "backend/**/account/**",
          "backend/**/roles/**",
          "backend/**/permissions/**",
          "backend/**/admin/**",
          "backend/**/webhooks/**",
          "backend/**/webhooks*.py",
          "backend/**/common/**",
          "backend/auth/**",
          "backend/mfa/**",
          "backend/accounts/**",
          "backend/roles/**",
          "backend/common/**",
          "backend/accounts/views.py",
          "backend/accounts/models.py",
          "backend/common/roles.py",
          "backend/common/fields.py",
          "backend/config/settings.py",
          "backend/settings/**",
          "backend/settings.py",
          "backend/**/settings/**",
          "backend/**/settings.py",
          "frontend/**/auth/**",
          "frontend/**/payment/**",
          "**/.env*",
          ".gitleaks.toml",
          "backend/urls.py",
          "backend/**/urls.py",
          "backend/**/views/**",
          "backend/**/api/**",
          "backend/**/serializers/**",
          "**/*.sql",
          "evidence/**",
          "backend/**/views*.py",
          "backend/**/views/*.py"
        ],
        "keywords": [
          "auth",
          "login",
          "password",
          "mfa",
          "otp",
          "session",
          "token",
          "secret",
          "admin",
          "tenant",
          "idor",
          "role",
          "permission",
          "account",
          "settings",
          "policy",
          "gate",
          "common"
        ]
      },
      "require_before": "builder"
    },
    {
      "rule_id": "DR-MONEY-01",
      "match": {
        "task_kind": [
          "FEATURE",
          "FIX",
          "SECURITY",
          "DOC",
          "INFRA",
          "DRAIN"
        ],
        "scope_globs": [
          "backend/**/payments/**",
          "backend/**/payment/**",
          "backend/**/refunds/**",
          "backend/**/refund/**",
          "backend/**/billing/**",
          "backend/**/money/**",
          "backend/**/pricing/**",
          "backend/**/auth/**",
          "backend/**/mfa/**",
          "backend/**/webhooks/**",
          "backend/**/admin/**",
          "backend/**/accounts/**",
          "backend/**/roles/**",
          "backend/**/settings/**",
          "backend/payments/**",
          "backend/refunds/**",
          "backend/auth/**",
          "backend/mfa/**",
          "backend/billing/**",
          "backend/money.py",
          "frontend/**/payment/**",
          "frontend/**/checkout/**",
          "**/.env*",
          "backend/orders/refunds.py",
          "backend/**/refunds.py",
          "backend/**/refund*.py",
          "backend/orders/models.py",
          "backend/accounts/views.py",
          "backend/accounts/models.py",
          "backend/common/roles.py",
          "backend/common/fields.py",
          "backend/config/settings.py",
          "backend/**/views/checkout*.py",
          "backend/**/views/payment*.py",
          "backend/**/views/refund*.py",
          "backend/**/orders/**",
          "backend/**/webhooks*.py"
        ],
        "keywords": [
          "refund",
          "payment",
          "payout",
          "invoice",
          "billing",
          "money",
          "webhook",
          "auth",
          "login",
          "password",
          "mfa",
          "otp",
          "session",
          "token",
          "admin",
          "secret",
          "tenant",
          "idor",
          "price",
          "role",
          "permission",
          "account",
          "checkout",
          "settings"
        ],
        "scope_globs_note": "A trailing '/**' also matches the module of that name (webhooks/ or webhooks.py); file-level forms are listed explicitly for tools that do not share that rule. `backend/**/orders/**` makes the money review cover the orders application, including `orders/views/checkout.py`, without pulling every backend view into a money dispatch."
      },
      "require_before": "builder"
    },
    {
      "rule_id": "DR-INFRA-01",
      "match": {
        "task_kind": [
          "INFRA"
        ],
        "scope_globs": [
          "**/Dockerfile",
          "**/docker-compose*.yml",
          "**/requirements*.txt",
          "**/pyproject.toml",
          "**/package.json",
          "**/package-lock.json",
          "**/conftest.py",
          "**/pytest.ini",
          "**/tox.ini",
          "**/.coveragerc",
          "**/*.sql",
          "backend/**/migrations/**",
          "backend/**/settings/**",
          "backend/**/settings.py",
          "backend/settings.py",
          "backend/settings/**",
          "backend/urls.py",
          "backend/**/urls.py",
          "backend/**/views/**",
          "backend/**/api/**",
          "backend/**/serializers/**",
          "backend/**/common/**",
          "backend/common/**",
          "backend/common/testing.py",
          "backend/config/settings.py",
          "evidence/**",
          "opencode.json",
          ".agt/**",
          ".gitleaks.toml",
          "**/.env*"
        ],
        "keywords": [
          "settings",
          "policy",
          "gate",
          "workflow",
          "migration",
          "common",
          "github",
          "role",
          "permission",
          "account",
          "secret",
          "token"
        ]
      },
      "require_before": "builder"
    }
  ]
}
