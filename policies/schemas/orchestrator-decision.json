{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestrator-decision.json",
  "title": "orchestrator-decision",
  "version": 2,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "lineage_id",
    "step",
    "action",
    "phase",
    "mode",
    "target",
    "lane",
    "reason_code",
    "predicate_ids",
    "evidence_refs",
    "state",
    "capability_id",
    "sig_status",
    "record_hash"
  ],
  "properties": {
    "schema": {
      "const": "orchestrator-decision/1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "lineage_id": {
      "type": "string",
      "minLength": 1
    },
    "step": {
      "type": "string",
      "enum": [
        "preflight",
        "resolve",
        "classify",
        "capability",
        "prebuild",
        "build",
        "audit",
        "route",
        "release",
        "postmerge",
        "lesson",
        "drain"
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "DISPATCH",
        "HOLD",
        "HALT",
        "RECORD"
      ]
    },
    "target": {
      "type": "string",
      "enum": [
        "builder",
        "auditor",
        "release-engineer",
        "compliance",
        "crouton-alpha",
        "none"
      ],
      "description": "Roles the orchestrator may dispatch. The hacker is never a target here: only the auditor spawns it in BUILD, and GATE forbids it."
    },
    "phase": {
      "type": "string",
      "enum": [
        "BUILD",
        "GATE"
      ],
      "description": "Two-phase state machine from files/policies/phases.json. BUILD alternates author and auditor per lane; GATE is release-engineer-exclusive."
    },
    "mode": {
      "type": "string",
      "enum": [
        "INTAKE",
        "RESUME",
        "FEATURE",
        "BUGFIX",
        "SPEC_COMPLETION",
        "BUILD",
        "AUDIT",
        "DELTA_AUDIT",
        "BUG_FINDING",
        "COMPLIANCE",
        "DOCS",
        "DRAIN",
        "EVALUATION",
        "RELEASE",
        "ESCALATION",
        "PARK"
      ],
      "description": "Visible workflow mode from files/policies/modes.json; must be allowed for this phase and this role."
    },
    "lane": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "lane/a",
        "lane/b",
        "spec-comp",
        null
      ],
      "description": "Permanent lane for a BUILD dispatch. A release-engineer GATE dispatch is lane-less (null). A lane-required target with lane=null is refused by the phase validator."
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "OK",
        "TIER_RAISED",
        "DIRTY_TREE",
        "HEAD_MOVED",
        "UNKNOWN_WORKTREE",
        "SCOPE_VIOLATION",
        "SIG_INVALID",
        "SCHEMA_INVALID",
        "CTRL_MISSING",
        "CTRL_FAILED",
        "NO_ACCEPTANCE_REF",
        "BUDGET_EXCEEDED",
        "CYCLES_EXHAUSTED",
        "RISK_RECORD_MISSING",
        "VERDICT_STALE",
        "CHECKS_INCOMPLETE",
        "TREE_MISMATCH",
        "CI_FAILED",
        "CI_TIMEOUT",
        "CI_PENDING",
        "SUBAGENT_TIMEOUT",
        "LEDGER_CONFLICT",
        "BUILDER_BLOCKED",
        "RELEASE_REFUSED",
        "POLICY_DRIFT",
        "POLICY_DRIFT_SHADOW",
        "ADDED_TEST_NOT_RED",
        "NON_FALSIFIABLE",
        "WEAK_ORACLE",
        "GUARD_REMOVED",
        "ARCH_VIOLATION",
        "AUTHZ_MATRIX_GAP",
        "BUDGET_ZERO_PROGRESS",
        "DRAIN_UNREPRODUCIBLE",
        "DRAIN_STAGE_MISSING",
        "SECRET_LEAK",
        "GATE_CONTROL_FAILURE",
        "CONTROL_UNDERCOUNT",
        "SUITE_FAILURE",
        "PARKED"
      ]
    },
    "predicate_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^P-[A-Z]+$"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_ref"
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "head",
        "tree"
      ],
      "properties": {
        "base": {
          "$ref": "#/$defs/git_sha"
        },
        "head": {
          "$ref": "#/$defs/git_sha"
        },
        "tree": {
          "$ref": "#/$defs/git_sha"
        }
      }
    },
    "capability_id": {
      "type": "string",
      "pattern": "^cap_[A-Za-z0-9_-]{8,64}$",
      "description": "Must match capability.json capability_id (cap_ prefix). Cross-schema propagation from capability."
    },
    "drain_stage": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "R1",
        "R2",
        "R3",
        "R4",
        "R5",
        null
      ]
    },
    "drain_cluster_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "sig_status": {
      "const": "unsigned_local"
    },
    "record_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "git_sha": {
      "type": "string",
      "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "phase"
        ],
        "properties": {
          "phase": {
            "const": "GATE"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "enum": [
              "release-engineer",
              "none"
            ]
          },
          "lane": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "phase"
        ],
        "properties": {
          "phase": {
            "const": "BUILD"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "enum": [
              "builder",
              "auditor",
              "compliance",
              "crouton-alpha",
              "none"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "enum": [
              "builder",
              "auditor"
            ]
          },
          "action": {
            "const": "DISPATCH"
          }
        }
      },
      "then": {
        "properties": {
          "phase": {
            "const": "BUILD"
          },
          "lane": {
            "enum": [
              "lane/a",
              "lane/b",
              "spec-comp"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "target",
          "action"
        ],
        "properties": {
          "target": {
            "const": "release-engineer"
          },
          "action": {
            "const": "DISPATCH"
          }
        }
      },
      "then": {
        "properties": {
          "phase": {
            "const": "GATE"
          },
          "lane": {
            "const": null
          }
        }
      }
    }
  ]
}
