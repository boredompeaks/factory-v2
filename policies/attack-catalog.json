{
  "version": 1,
  "catalog_ref_prefix": "policies/attack-catalog.json#/items/",
  "variant_profiles": {
    "high": {
      "max_items": 12,
      "budget_share": 0.5,
      "stop_on_budget": true
    },
    "max": {
      "max_items": 12,
      "budget_share": 0.75,
      "stop_on_budget": true
    }
  },
  "probe_counting": {
    "probe_definition": "One probe is one distinct execution of a probe against the runtime. Vary the endpoint, the tenant pair, or the engine to make a new probe; re-running the same execution does not add to the count.",
    "coverage_rule": "Each item requires at least one execution in every listed probe_class, and the item's total executions must reach min_probes for the hacker variant. REFUTED is only valid when both hold.",
    "skip_rule_none_tier": "When policies/tiers.json[tier].hacker_variant is 'none', there are no execution profiles: skip the hacker relay and the catalog entirely. No probes are run or counted.",
    "schema_followup": "Per-probe execution records are persisted by factory probe as probe-record/1 proof records under evidence/probe/ (one record per distinct execution; schema at policies/schemas/probe-record.json). The auditor validates the returned probes against this catalog (>=1 per probe_class, total >= min_probes). A counted execution is blocked or reproduced; a reproduced outcome is a finding, not a refutation. REFUTED requires at least one blocked probe in every listed probe_class and total blocked >= min_probes. An error, an ineligible engine, or an off-catalog class never counts. The audit cites the proof proof_root in the verdict evidence_ref."
  },
  "engine_policy": {
    "concurrent_writer_classes": [
      "double_spend",
      "stock_oversell",
      "concurrent_cancel",
      "watermark_regression"
    ],
    "required_engine_by_class": {
      "double_spend": "postgres",
      "stock_oversell": "postgres",
      "concurrent_cancel": "postgres",
      "watermark_regression": "postgres"
    },
    "sqlite": "Single-writer only. A probe that opens more than one concurrent writer on SQLite fails with OperationalError/database-is-locked; that is an ENGINE_FAULT, never an application gate and never coverage.",
    "error_rule": "An outcome of `error` never counts toward min_probes or REFUTED, on any engine.",
    "counting_rule": "A counted probe is a distinct (item_id, probe_class, endpoint, tenant_pair, engine) execution with outcome blocked|reproduced, whose probe_class is declared by the item and whose engine is eligible for that class. Reruns are not new probes. An error outcome, an ineligible engine, or a class the item does not declare never counts.",
    "retry_rule": "When a class is engine-ineligible on the runtime, run it on the required engine in the same campaign; do not spend the remaining budget on the ineligible engine."
  },
  "campaign": {
    "unit": "release_train",
    "children_per_train": 1,
    "parent": "release-engineer",
    "sweep_parent": "auditor",
    "scope": "whole_train",
    "boundary_ref": "policies/phases.json#/release_train",
    "statement": "One hacker campaign per release train, at the BUILD->GATE section boundary. The release-engineer runs once per boundary, not once per task, and spawns exactly one hacker campaign that attacks every task in the train together to find seams between changes. The only other edge is auditor -> hacker in BUG_FINDING. Never one campaign per task, per flow, or per batch.",
    "invocations_per_train": 1,
    "cost_control": {
      "invocations_per_train": 1,
      "children_per_invocation": 1,
      "retries": 0,
      "budget_ref": "policies/attack-catalog.json#/variant_profiles",
      "statement": "One campaign invocation per release train bounds cost. It stops at its variant profile budget and records NOT_RUN; there is no second pass, no per-task campaign, and no per-batch child."
    }
  },
