{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.local/schemas/task.json",
  "title": "Factory task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "kind",
    "lane",
    "worktree",
    "branch",
    "base_sha",
    "scope",
    "phase",
    "mode",
    "tier",
    "created_at"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "kind": {
      "type": "string",
      "enum": ["FEATURE", "FIX", "SECURITY", "DOC"]
    },
    "lane": {
      "type": "string",
      "enum": ["lane/a", "lane/b", "spec-comp"]
    },
    "worktree": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Human-readable task title recorded at mint time; the builder brief carries the detail."
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "phase": {
      "type": "string",
      "enum": ["BUILD", "GATE"]
    },
    "mode": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "type": "string",
      "enum": ["none", "high", "max"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
