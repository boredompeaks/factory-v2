{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate.json",
  "title": "Factory gate policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "engines",
    "test_infra_paths",
    "lint",
    "lint_command",
    "gate_paths",
    "gate_checks",
    "gate_sets_by_kind",
    "proof_rule",
    "policy_digest_scope",
    "gate_control_cache_key",
    "gate_control_required"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "engines": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["sqlite", "postgres"]
      }
    },
    "test_infra_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lint": {
      "type": "string",
      "minLength": 1
    },
    "lint_command": {
      "type": "string",
      "minLength": 1
    },
    "gate_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gate_checks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "SCOPE",
          "SUITE",
          "TEST_SET",
          "TEST_INFRA",
          "BASE_FAIL_HEAD_PASS",
          "MUTATION",
          "CHANGELOG",
          "SECRETS",
          "CONVENTION",
          "SMELL",
          "GATE_CONTROLS",
          "POLICY_DIGEST",
          "ARCH",
          "ORACLE_PROVENANCE",
          "GUARD_DELTA",
          "AUTHZ_MATRIX",
          "SEMGREP",
          "THREAD_RACE",
          "SCHEMA_FUZZ",
          "BOOTTEST",
          "ZIZMOR",
          "DAST_BASELINE",
          "AGT_PARITY",
          "AGT_AUDIT",
          "RADON",
          "BANDIT"
        ]
      }
    },
    "gate_sets_by_kind": {
      "type": "object",
      "propertyNames": {
        "enum": ["DOC", "FIX", "FEATURE", "SECURITY", "release"]
      },
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "enum": [
            "SCOPE",
            "SUITE",
            "TEST_SET",
            "TEST_INFRA",
            "BASE_FAIL_HEAD_PASS",
            "MUTATION",
            "CHANGELOG",
            "SECRETS",
            "CONVENTION",
            "SMELL",
            "GATE_CONTROLS",
            "POLICY_DIGEST",
            "ARCH",
            "ORACLE_PROVENANCE",
            "GUARD_DELTA",
            "AUTHZ_MATRIX",
            "SEMGREP",
            "THREAD_RACE",
            "SCHEMA_FUZZ",
            "BOOTTEST",
            "ZIZMOR",
            "DAST_BASELINE",
            "AGT_PARITY",
            "AGT_AUDIT",
            "RADON",
            "BANDIT"
          ]
        }
      }
    },
    "proof_rule": {
      "type": "string",
      "minLength": 1
    },
    "policy_digest_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gate_control_cache_key": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["gate_sha", "control_set_sha", "policy_digest"]
      }
    },
    "gate_control_required": {
      "type": "boolean"
    }
  }
}
